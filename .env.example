# ==============================================================================
# Veridex Environment Configuration (.env.example)
# Copy to .env and provide real credentials. Never commit real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED FOR PRODUCTION / PERSISTENT MODE
# ------------------------------------------------------------------------------

# Database: PostgreSQL (Neon or self-hosted) with or without pgvector.
# PostgresIndex auto-creates tables (manifests, watermark_bindings, perceptual_hashes, merkle_leaves)
# on startup. In local development without this variable, Veridex runs in-memory.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Backblaze B2 Object Storage (content-addressed media, manifests, and signatures)
B2_KEY_ID=your_b2_application_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET_DEV=your_primary_bucket_name
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Application-Owned Ingest Secret (X-Ingest-Key header for POST /ingest)
VERIDEX_INGEST_KEY=your_generated_random_hex_token

# Stable Ed25519 signing key (64-character hex seed) so checkpoint signatures and Merkle proofs
# stay stable across server restarts. If unset in dev, an ephemeral key is generated on startup.
ED25519_PRIVATE_KEY_HEX=your_generated_64_hex_ed25519_seed

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT DEFAULTS
# ------------------------------------------------------------------------------
APP_ENV=development
VERIDEX_DEMO_SEED=1
API_PROXY_TARGET=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. OPTIONAL FEATURES (Leave unset for free-tier / graceful degradation)
# ------------------------------------------------------------------------------

# Live AI Image Generation (POST /demo/generate):
# If unset or keys missing, Veridex serves the seeded demo image with zero error.
# Note: The codebase currently uses Genblaze (GMI Cloud or OpenAI DALL-E).
VERIDEX_LIVE_GENERATE=0
GMI_CLOUD_API_KEY=
OPENAI_API_KEY=
VERIDEX_GMI_MODEL=seedream-5.0-lite

# AI Provenance Agent (POST /demo/agent):
# Claude tool-use provenance assistant. If unset, returns an honest disabled message with suggested prompts.
ANTHROPIC_API_KEY=
VERIDEX_AGENT_MODEL=claude-opus-4-8

# B2 Object Lock Bucket for WORM-sealed tamper-evident Merkle checkpoints:
# Requires an Object-Lock-enabled B2 bucket with Compliance retention enabled.
B2_BUCKET_LOCKED=
VERIDEX_CHECKPOINT_RETAIN_DAYS=30

# Remote Neural Watermarking (Modal Serverless with PyTorch + TrustMark):
# If unset, Veridex uses the built-in FakeWatermarker and recovers via 256-bit PDQ Hamming perceptual hashing.
VERIDEX_WATERMARK_REMOTE_URL=
VERIDEX_WATERMARK_REMOTE_TOKEN=
VERIDEX_REAL_WATERMARK=0

# B2 Event Notification Webhook (POST /webhooks/b2-event):
B2_EVENT_SIGNING_SECRET=

# SBR Federation Peers (comma-separated URLs):
VERIDEX_SBR_PEERS=
